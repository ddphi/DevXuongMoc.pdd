@model IEnumerable<DevXuongMoc.Web.Models.Entities.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" asp-controller="Categories" asp-area="Admin" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slug)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IconPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SortOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsVisible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)  S
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Slug)
            </td>
            <td>
                @Html.DisplayFor(model => item.IconPath)
            </td>
            <td>
                @Html.DisplayFor(model => item.SortOrder)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsVisible)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-controller="Categories" asp-area="Admin">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" asp-controller="Categories" asp-area="Admin">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" asp-controller="Categories" asp-area="Admin">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
