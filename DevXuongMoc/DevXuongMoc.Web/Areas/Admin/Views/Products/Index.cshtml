@model IEnumerable<DevXuongMoc.Web.Models.Entities.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slug)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShortDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShortSpec)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Spec)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Care)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Warranty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Commitment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Features)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarrantyMonths)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsFeatured)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ViewCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsDeleted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactRequests)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductImages)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductVariants)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CategoryId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Slug)
            </td>
            <td>
                @Html.DisplayFor(model => item.ShortDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.ShortSpec)
            </td>
            <td>
                @Html.DisplayFor(model => item.Spec)
            </td>
            <td>
                @Html.DisplayFor(model => item.Care)
            </td>
            <td>
                @Html.DisplayFor(model => item.Warranty)
            </td>
            <td>
                @Html.DisplayFor(model => item.Commitment)
            </td>
            <td>
                @Html.DisplayFor(model => item.Features)
            </td>
            <td>
                @Html.DisplayFor(model => item.WarrantyMonths)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsFeatured)
            </td>
            <td>
                @Html.DisplayFor(model => item.ViewCount)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsDeleted)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category)
            </td>
            <td>
                @Html.DisplayFor(model => item.ContactRequests)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductImages)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductVariants)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-controller="Products" asp-area="Admin">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" asp-controller="Products" asp-area="Admin">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" asp-controller="Products" asp-area="Admin">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
